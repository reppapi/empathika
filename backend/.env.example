# Database (Ganti 'postgres' dan 'password_kamu' sesuai password PostgreSQL Anda)
DATABASE_URL="postgresql://user:password@localhost:5432/empathika_db?schema=public"

# JWT
JWT_SECRET=rahasia-banget-minimal-32-karakter-harus-panjang-ya
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Base URL (digunakan untuk generate URL file upload)
BASE_URL=http://localhost:3001

# Frontend public URL (dipakai untuk membentuk tautan aktivasi)
FRONTEND_URL=http://localhost:3000

# Payment Gateway (xendit / midtrans)
PAYMENT_GATEWAY=xendit
XENDIT_SECRET_KEY=xnd_development_...
XENDIT_WEBHOOK_TOKEN=your_callback_verification_token
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@empathika.id

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Google OAuth
GOOGLE_CLIENT_ID=
