generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BIRO
  PSIKOLOG
}

enum StatusBiro {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum JenisEvent {
  WEBINAR
  WORKSHOP
  SEMINAR
}

enum StatusEvent {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum KategoriLayanan {
  KONSULTASI_INDIVIDU
  KONSULTASI_PASANGAN
  KONSULTASI_ANAK
}

enum StatusBooking {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MetodePembayaran {
  TRANSFER_BANK
  E_WALLET
  QRIS
}

enum StatusPembayaran {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StatusPsikolog {
  ACTIVE
  INACTIVE
}

enum JenisAksesPsikotes {
  GRATIS
  BERBAYAR
}

enum StatusSlot {
  TERSEDIA
  SUDAH_DIBOOKING
  TIDAK_TERSEDIA
}

// ==========================================
// AKUN STAF / LOGIN (ADMIN, BIRO, PSIKOLOG)
// ==========================================

model Account {
  id         String   @id @default(uuid())
  nama       String
  email      String   @unique
  password   String   // Hash kata sandi
  role       Role     @default(ADMIN)
  no_telepon String?
  foto       String?
  aktif      Boolean  @default(true)
  id_biro    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  biro       Biro?     @relation("BiroStaff", fields: [id_biro], references: [id])
  owned_biro Biro[]    @relation("BiroOwner")
  psikolog   Psikolog?

  @@map("accounts")
}

// ==========================================
// KLIEN / PASIEN TAMU (TANPA LOGIN / PASSWORD)
// ==========================================

model Client {
  id               String   @id @default(uuid())
  id_biro          String?
  nama             String
  no_telepon       String?
  email            String?  // Opsional (tidak unique, 1 email bisa dipakai booking berkali-kali)
  deskripsi_trauma String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  biro Biro? @relation(fields: [id_biro], references: [id])

  booking_konsultasi BookingKonsultasi[]
  booking_event      BookingEvent[]
  booking_psikotes   BookingPsikotes[]
  transaksi          Transaksi[]

  @@map("clients")
}

// ==========================================
// BIRO & KOMUNITAS MITRA (TENANT)
// ==========================================

model Biro {
  id         String     @id @default(uuid())
  nama_biro  String
  slug       String     @unique
  id_account String     // Penanggung jawab / Owner
  logoURI    String?
  warna_tema String?
  alamat     String?    @db.Text
  aktif      Boolean    @default(true)
  status     StatusBiro @default(ACTIVE)

  owner   Account   @relation("BiroOwner", fields: [id_account], references: [id])
  staff   Account[] @relation("BiroStaff")
  clients Client[]

  @@map("biros")
}

// ==========================================
// EVENT
// ==========================================

model Event {
  id             String      @id @default(uuid())
  judul          String
  jenis_event    JenisEvent
  deskripsi      String      @db.Text
  tanggal        DateTime    @db.Date
  jam_mulai      DateTime    @db.Time()
  durasi_menit   Int
  lokasi         String?
  kuota          Int
  harga          Decimal     @db.Decimal(12, 2)
  banner_url     String?
  nama_pembicara String
  status         StatusEvent @default(UPCOMING)

  booking_event BookingEvent[]

  @@map("events")
}

// ==========================================
// LAYANAN & PSIKOLOG
// ==========================================

model Layanan {
  id            String          @id @default(uuid())
  nama          String
  kategori      KategoriLayanan
  deskripsi     String          @db.Text
  harga_weekday Decimal         @db.Decimal(12, 2)
  harga_weekend Decimal         @db.Decimal(12, 2)
  banner_url    String?
  aktif         Boolean         @default(true)

  booking_konsultasi BookingKonsultasi[]

  @@map("layanans")
}

model Spesialisasi {
  id   String @id @default(uuid())
  nama String

  psikolog Psikolog[]

  @@map("spesialisasi")
}

model Psikolog {
  id              String         @id @default(uuid())
  id_account      String         @unique // Relasi 1-to-1 ke Account (Login)
  id_spesialisasi String
  nama_gelar      String
  no_str          String?
  foto            String?
  bio             String?        @db.Text
  status          StatusPsikolog @default(ACTIVE)
  jumlah_sesi     Int            @default(0)
  tarif_per_jam   Decimal        @db.Decimal(12, 2)

  account      Account      @relation(fields: [id_account], references: [id], onDelete: Cascade)
  spesialisasi Spesialisasi @relation(fields: [id_spesialisasi], references: [id])
  jadwal_slot  JadwalSlot[]
  testimoni    Testimoni[]

  @@map("psikologs")
}

model JadwalSlot {
  id          String     @id @default(uuid())
  id_psikolog String
  tanggal     DateTime   @db.Date
  jam_mulai   DateTime   @db.Time()
  jam_selesai DateTime   @db.Time()
  status      StatusSlot @default(TERSEDIA)

  psikolog           Psikolog            @relation(fields: [id_psikolog], references: [id])
  booking_konsultasi BookingKonsultasi?

  @@map("jadwal_slots")
}

model Testimoni {
  id           String  @id @default(uuid())
  id_psikolog  String
  isi          String  @db.Text
  anonim       Boolean @default(false)
  nama_pemberi String?

  psikolog Psikolog @relation(fields: [id_psikolog], references: [id])

  @@map("testimonis")
}

// ==========================================
// BOOKING & TRANSAKSI
// ==========================================

model Transaksi {
  id                String           @id @default(uuid())
  id_client         String
  subtotal          Decimal          @db.Decimal(12, 2)
  biaya_admin       Decimal          @db.Decimal(12, 2)
  metode_pembayaran MetodePembayaran
  status_pembayaran StatusPembayaran @default(PENDING)
  tanggal_bayar     DateTime?

  client Client @relation(fields: [id_client], references: [id])

  booking_konsultasi BookingKonsultasi?
  booking_event      BookingEvent?
  booking_psikotes   BookingPsikotes?

  @@map("transaksis")
}

model BookingKonsultasi {
  id               String        @id @default(uuid())
  kode_pesanan     String        @unique
  id_client        String
  id_layanan       String
  id_jadwal        String        @unique
  id_transaksi     String        @unique
  deskripsi_trauma String?       @db.Text
  status           StatusBooking @default(PENDING)

  client    Client     @relation(fields: [id_client], references: [id])
  layanan   Layanan    @relation(fields: [id_layanan], references: [id])
  jadwal    JadwalSlot @relation(fields: [id_jadwal], references: [id])
  transaksi Transaksi  @relation(fields: [id_transaksi], references: [id])

  @@map("booking_konsultasi")
}

model BookingEvent {
  id           String @id @default(uuid())
  id_event     String
  id_client    String
  id_transaksi String @unique
  nama_lengkap String
  no_hp        String

  event     Event     @relation(fields: [id_event], references: [id])
  client    Client    @relation(fields: [id_client], references: [id])
  transaksi Transaksi @relation(fields: [id_transaksi], references: [id])

  @@map("booking_events")
}

// ==========================================
// PSIKOTES
// ==========================================

model PaketPsikotes {
  id          String             @id @default(uuid())
  judul       String
  kategori    String
  jenis_akses JenisAksesPsikotes
  harga       Decimal            @db.Decimal(12, 2)
  bannerURL   String?
  is_active   Boolean            @default(true)
  deskripsi   String?            @db.Text

  soal_psikotes         SoalPsikotes[]
  interpretasi_psikotes InterpretasiPsikotes[]
  booking_psikotes      BookingPsikotes[]

  @@map("paket_psikotes")
}

model SoalPsikotes {
  id         String @id @default(uuid())
  id_paket   String
  urutan     Int
  pertanyaan String @db.Text

  paket            PaketPsikotes     @relation(fields: [id_paket], references: [id], onDelete: Cascade)
  pilihan_jawaban  PilihanJawaban[]
  jawaban_psikotes JawabanPsikotes[]

  @@map("soal_psikotes")
}

model PilihanJawaban {
  id           String @id @default(uuid())
  id_soal      String
  label        String
  teks_jawaban String @db.Text
  bobot        Int

  soal             SoalPsikotes      @relation(fields: [id_soal], references: [id], onDelete: Cascade)
  jawaban_psikotes JawabanPsikotes[]

  @@map("pilihan_jawabans")
}

model InterpretasiPsikotes {
  id        String  @id @default(uuid())
  id_paket  String
  min_skor  Int
  max_skor  Int
  grade     String
  judul     String
  deskripsi String  @db.Text

  paket     PaketPsikotes @relation(fields: [id_paket], references: [id], onDelete: Cascade)
  hasil_tes HasilTes[]

  @@map("interpretasi_psikotes")
}

model BookingPsikotes {
  id           String   @id @default(uuid())
  id_paket     String
  id_transaksi String   @unique
  id_client    String
  created_at   DateTime @default(now())

  paket     PaketPsikotes @relation(fields: [id_paket], references: [id])
  transaksi Transaksi     @relation(fields: [id_transaksi], references: [id])
  client    Client        @relation(fields: [id_client], references: [id])

  jawaban_psikotes JawabanPsikotes[]
  hasil_tes        HasilTes?

  @@map("booking_psikotes")
}

model JawabanPsikotes {
  id                 String @id @default(uuid())
  id_booking         String
  id_soal_psikotes   String
  id_pilihan_jawaban String
  skor               Int

  booking         BookingPsikotes @relation(fields: [id_booking], references: [id])
  soal_psikotes   SoalPsikotes    @relation(fields: [id_soal_psikotes], references: [id])
  pilihan_jawaban PilihanJawaban  @relation(fields: [id_pilihan_jawaban], references: [id])

  @@map("jawaban_psikotes")
}

model HasilTes {
  id              String   @id @default(uuid())
  id_booking      String   @unique
  id_interpretasi String
  total_skor      Int
  tanggal_selesai DateTime @default(now())

  booking      BookingPsikotes      @relation(fields: [id_booking], references: [id])
  interpretasi InterpretasiPsikotes @relation(fields: [id_interpretasi], references: [id])

  @@map("hasil_tes")
}

// ==========================================
// BLOG
// ==========================================

model ArtikelBlog {
  id               String   @id @default(uuid())
  judul            String
  slug             String   @unique
  isi              String   @db.Text
  waktu_baca_menit Int
  tanggal_terbit   DateTime @default(now())
  jumlah_dilihat   Int      @default(0)

  @@map("artikel_blogs")
}
