generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  BIRO
  PSIKOLOG
}

enum StatusBiro {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum JenisEvent {
  WEBINAR
  WORKSHOP
  SEMINAR
}

enum TipeEvent {
  ONLINE
  OFFLINE
}

enum StatusEvent {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  DRAFT
}

enum KategoriLayanan {
  KONSULTASI
  WORKSHOP
  SEMINAR
  ASESMEN
}

enum StatusBooking {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MetodePembayaran {
  TRANSFER_BANK
  E_WALLET
  QRIS
}

enum StatusPembayaran {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StatusPsikolog {
  ACTIVE
  INACTIVE
}

enum JenisAksesPsikotes {
  GRATIS
  BERBAYAR
}

enum StatusPengerjaan {
  BELUM_MULAI
  SELESAI
}

enum StatusSlot {
  TERSEDIA
  SUDAH_DIBOOKING
  TIDAK_TERSEDIA
}

enum StatusPengajuanKerjaSama {
  MENUNGGU
  DIHUBUNGI
  DISETUJUI
  DITOLAK
}

enum TipeTransaksi {
  KONSULTASI
  EVENT
  PSIKOTES
}

// ==========================================
// 1. AUTENTIKASI, TENANT & KLIEN (TAMU)
// ==========================================

model Account {
  id                 String    @id @default(uuid())
  nama               String
  email              String    @unique
  password           String?   // Hash kata sandi
  role               Role      @default(ADMIN)
  no_telepon         String?
  foto               String?
  bio                String?   @db.Text
  alamat             String?   @db.Text
  link_maps          String?
  instagram          String?
  tiktok             String?
  youtube            String?
  linkedin           String?
  aktif              Boolean   @default(false)
  token_aktivasi     String?   @unique
  token_aktivasi_exp DateTime?
  id_biro            String?

  // === FIELD KEAMANAN BARU ===
  passwordChangedAt    DateTime?
  tokenVersion         Int                   @default(1)
  email_change_requests EmailChangeRequest[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  biro       Biro?     @relation("BiroStaff", fields: [id_biro], references: [id], onDelete: SetNull)
  owned_biro Biro[]    @relation("BiroOwner")
  psikolog   Psikolog?

  @@map("accounts")
}

model EmailChangeRequest {
  id         String    @id @default(uuid())
  accountId  String
  newEmail   String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("email_change_requests")
}


model Client {
  id            String   @id @default(uuid())
  id_biro       String?
  nama          String
  no_telepon    String?  // Kontak operasional WhatsApp klien
  usia          Int?
  jenis_kelamin String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  biro Biro? @relation(fields: [id_biro], references: [id], onDelete: SetNull)

  booking_konsultasi BookingKonsultasi[]
  booking_event      BookingEvent[]
  booking_psikotes   BookingPsikotes[]
  transaksi          Transaksi[]

  @@map("clients")
}

model Biro {
  id          String     @id @default(uuid())
  nama_biro   String
  slug        String     @unique
  id_account  String     // Penanggung jawab / Owner
  logoURI     String?
  warna_tema  String?
  alamat      String?    @db.Text
  deskripsi   String?    @db.Text
  no_telepon  String?
  website_url String?
  status      StatusBiro @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner   Account   @relation("BiroOwner", fields: [id_account], references: [id], onDelete: Restrict)
  staff   Account[] @relation("BiroStaff")
  clients Client[]

  @@map("biros")
}

// ==========================================
// 2. LAYANAN, TENAGA AHLI & JADWAL
// ==========================================

model Layanan {
  id            String          @id @default(uuid())
  nama          String
  kategori      KategoriLayanan
  metode        String          @default("Online/Offline")
  deskripsi     String          @db.Text
  harga_weekday     Decimal         @db.Decimal(12, 2)
  harga_weekend     Decimal         @db.Decimal(12, 2)
  tarif_tenaga_ahli Json?
  banner_url        String?
  aktif         Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  booking_konsultasi BookingKonsultasi[]

  @@map("layanans")
}

model Spesialisasi {
  id   String @id @default(uuid())
  nama String

  psikolog Psikolog[]

  @@map("spesialisasi")
}

model Psikolog {
  id                String         @id @default(uuid())
  id_account        String         @unique // Relasi 1-to-1 ke Account (Login)
  id_spesialisasi   String
  kategori          String         // Multi-profesi: Psikolog Klinis, Konselor, Peer Konselor
  nama_gelar        String
  no_str            String?        // Wajib untuk Psikolog, Opsional untuk Konselor, Null untuk Peer Konselor
  no_sipp           String?        // Wajib untuk Psikolog, Opsional untuk Konselor, Null untuk Peer Konselor
  no_silp           String?   // Surat Izin Layanan Psikolog
  pendidikan        String?
  pengalaman_tahun  String?
  quote             String?        @db.Text
  instagram         String?
  keahlian          String?        // Multi-topik keahlian
  jenis_kelamin     String?
  foto              String?
  bio               String?        @db.Text
  video_intro_url   String?
  video_thumbnail   String?
  video_duration    String?
  profil_lengkap    String?        @db.Text
  status            StatusPsikolog @default(ACTIVE)
  jumlah_sesi       Int            @default(0)
  tarif_per_jam     Decimal        @db.Decimal(12, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  account      Account      @relation(fields: [id_account], references: [id], onDelete: Cascade)
  spesialisasi Spesialisasi @relation(fields: [id_spesialisasi], references: [id], onDelete: Restrict)
  jadwal_slot  JadwalSlot[]

  @@map("psikologs")
}

model JadwalSlot {
  id          String     @id @default(uuid())
  id_psikolog String
  tipe_jadwal String     @default("KONSULTASI") // "KONSULTASI" | "ASESMEN"
  metode      String     @default("ONLINE") // "ONLINE" | "OFFLINE"
  tanggal     DateTime   @db.Date
  jam_mulai   DateTime   @db.Time()
  jam_selesai DateTime   @db.Time()
  status      StatusSlot @default(TERSEDIA)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  psikolog           Psikolog            @relation(fields: [id_psikolog], references: [id], onDelete: Restrict)
  booking_konsultasi BookingKonsultasi?

  @@map("jadwal_slots")
}

// ==========================================
// 3. TRANSAKSI & BOOKING KONSULTASI
// ==========================================

model Transaksi {
  id                 String           @id @default(uuid())
  id_client          String
  kode_transaksi     String?          @unique
  tipe_transaksi     TipeTransaksi
  subtotal           Decimal          @db.Decimal(12, 2)
  biaya_admin        Decimal          @db.Decimal(12, 2)
  total              Decimal          @db.Decimal(12, 2)
  metode_pembayaran  MetodePembayaran
  channel_pembayaran String?
  status_pembayaran  StatusPembayaran @default(PENDING)
  tanggal_bayar      DateTime?
  data_pembayaran    String?          @db.Text
  refund_at          DateTime?
  refund_reason      String?          @db.Text
  refund_amount      Decimal?         @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  client Client @relation(fields: [id_client], references: [id], onDelete: Restrict)

  booking_konsultasi BookingKonsultasi?
  booking_event      BookingEvent?
  booking_psikotes   BookingPsikotes?
  invoice            Invoice?

  @@map("transaksis")
}

model BookingKonsultasi {
  id               String        @id @default(uuid())
  kode_pesanan     String        @unique
  id_client        String
  id_layanan       String
  id_jadwal        String        @unique
  id_transaksi     String?       @unique // Nullable untuk sesi mandiri admin / walk-in
  metode           String        @default("ONLINE") // "ONLINE" | "OFFLINE"
  deskripsi_trauma String?       @db.Text
  status           StatusBooking @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client    Client     @relation(fields: [id_client], references: [id], onDelete: Restrict)
  layanan   Layanan    @relation(fields: [id_layanan], references: [id], onDelete: Restrict)
  jadwal    JadwalSlot @relation(fields: [id_jadwal], references: [id], onDelete: Restrict)
  transaksi Transaksi? @relation(fields: [id_transaksi], references: [id], onDelete: SetNull)

  @@map("booking_konsultasi")
}

// ==========================================
// 4. EVENT & WORKSHOP
// ==========================================

model Event {
  id             String      @id @default(uuid())
  judul          String
  jenis_event    JenisEvent
  deskripsi      String      @db.Text
  tanggal        DateTime    @db.Date
  jam_mulai      DateTime    @db.Time()
  durasi_menit   Int
  lokasi         String?
  kuota          Int
  harga          Decimal     @db.Decimal(12, 2)
  banner_url     String?
  nama_pembicara String
  tipe_event     TipeEvent   @default(ONLINE)
  link_meet      String?
  link_wa        String?
  harga_coret    Decimal?    @db.Decimal(12, 2)
  harga_bundling Decimal?    @db.Decimal(12, 2)
  kuota_tiket_bundling Int?    @default(2)
  nama_bundling  String?
  paket_bundling Json?
  status         StatusEvent @default(UPCOMING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  booking_event BookingEvent[]

  @@map("events")
}

// ==========================================
// 4b. DOKUMENTASI EVENT SELESAI
// ==========================================

model EventDokumentasi {
  id        String   @id @default(uuid())
  judul     String
  kategori  String   @default("KOLABORASI") // SEMINAR | WORKSHOP | KOLABORASI
  tanggal   DateTime @db.Date
  deskripsi String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foto EventDokumentasiFoto[]

  @@map("event_dokumentasi")
}

model EventDokumentasiFoto {
  id                   String   @id @default(uuid())
  id_event_dokumentasi String
  foto_url             String
  urutan               Int      @default(0)
  createdAt            DateTime @default(now())

  dokumentasi EventDokumentasi @relation(fields: [id_event_dokumentasi], references: [id], onDelete: Cascade)

  @@map("event_dokumentasi_foto")
}


model BookingEvent {
  id                    String        @id @default(uuid())
  id_event              String
  id_client             String
  id_transaksi          String        @unique // Wajib (NOT NULL) karena seluruh event publik berbayar
  kode_tiket            String        @unique
  jumlah_peserta        Int           @default(1)
  nama_peserta_tambahan Json?
  status                StatusBooking @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  event     Event     @relation(fields: [id_event], references: [id], onDelete: Restrict)
  client    Client    @relation(fields: [id_client], references: [id], onDelete: Restrict)
  transaksi Transaksi @relation(fields: [id_transaksi], references: [id], onDelete: Restrict)

  @@map("booking_events")
}

// ==========================================
// 5. PSIKOTES ONLINE
// ==========================================

model AlatUkur {
  id             String          @id @default(uuid())
  kode           String          @unique // Misal: "GAD-7", "DASS-21"
  nama           String          // Nama instrumen
  kategori       String          // Misal: "Kesehatan Mental", "Kepribadian"
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  paket_psikotes PaketPsikotes[]

  @@map("alat_ukurs")
}

model PaketPsikotes {
  id            String             @id @default(uuid())
  id_alat_ukur  String?
  judul       String
  jenis_akses JenisAksesPsikotes
  harga       Decimal            @db.Decimal(12, 2)
  banner_url  String?
  tentang_tes String?            @db.Text
  status      String             @default("PUBLISHED")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  alat_ukur             AlatUkur?          @relation(fields: [id_alat_ukur], references: [id], onDelete: SetNull)
  soal_psikotes         SoalPsikotes[]
  interpretasi_psikotes InterpretasiPsikotes[]
  booking_psikotes      BookingPsikotes[]

  @@map("paket_psikotes")
}

model SoalPsikotes {
  id         String @id @default(uuid())
  id_paket   String
  urutan     Int
  pertanyaan String @db.Text

  paket            PaketPsikotes     @relation(fields: [id_paket], references: [id], onDelete: Cascade)
  pilihan_jawaban  PilihanJawaban[]
  jawaban_psikotes JawabanPsikotes[]

  @@unique([id_paket, urutan])
  @@index([id_paket])
  @@map("soal_psikotes")
}

model PilihanJawaban {
  id           String @id @default(uuid())
  id_soal      String
  label        String
  teks_jawaban String @db.Text
  bobot        Int

  soal             SoalPsikotes      @relation(fields: [id_soal], references: [id], onDelete: Cascade)
  jawaban_psikotes JawabanPsikotes[]

  @@index([id_soal])
  @@map("pilihan_jawabans")
}

model JawabanPsikotes {
  id                 String @id @default(uuid())
  id_booking         String
  id_soal_psikotes   String
  id_pilihan_jawaban String
  skor               Int

  booking         BookingPsikotes @relation(fields: [id_booking], references: [id], onDelete: Cascade)
  soal_psikotes   SoalPsikotes    @relation(fields: [id_soal_psikotes], references: [id], onDelete: Restrict)
  pilihan_jawaban PilihanJawaban  @relation(fields: [id_pilihan_jawaban], references: [id], onDelete: Restrict)

  @@unique([id_booking, id_soal_psikotes])
  @@map("jawaban_psikotes")
}

model InterpretasiPsikotes {
  id        String  @id @default(uuid())
  id_paket  String
  min_skor  Int
  max_skor  Int
  grade     String
  judul     String
  deskripsi String  @db.Text
  tips      Json?

  paket     PaketPsikotes @relation(fields: [id_paket], references: [id], onDelete: Cascade)
  hasil_tes HasilTes[]

  @@index([id_paket])
  @@map("interpretasi_psikotes")
}

model HasilTes {
  id              String   @id @default(uuid())
  id_booking      String   @unique
  id_interpretasi String?
  total_skor      Int
  detail_skor      Json?
  snapshot_jawaban Json?
  tanggal_selesai DateTime @default(now())
  createdAt       DateTime @default(now())

  booking      BookingPsikotes      @relation(fields: [id_booking], references: [id], onDelete: Cascade)
  interpretasi InterpretasiPsikotes? @relation(fields: [id_interpretasi], references: [id], onDelete: SetNull)

  @@map("hasil_tes")
}

model BookingPsikotes {
  id                String            @id @default(uuid())
  id_paket          String
  id_transaksi      String?           @unique // Nullable untuk paket psikotes gratis
  kode_akses        String?           @unique // Kode unik akses tiket pengerjaan psikotes
  status_pengerjaan StatusPengerjaan  @default(BELUM_MULAI)
  riwayat_kesehatan Json?
  id_client         String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  paket     PaketPsikotes @relation(fields: [id_paket], references: [id], onDelete: Restrict)
  transaksi Transaksi?    @relation(fields: [id_transaksi], references: [id], onDelete: SetNull)
  client    Client        @relation(fields: [id_client], references: [id], onDelete: Restrict)

  jawaban_psikotes JawabanPsikotes[]
  hasil_tes        HasilTes?
  peserta_psikotes PesertaPsikotes?

  @@map("booking_psikotes")
}

model PesertaPsikotes {
  id                   String    @id @default(uuid())
  id_booking           String    @unique // Relasi 1-to-1 ke booking_psikotes
  
  // Identitas Utama Peserta
  nama_lengkap         String
  no_telepon           String?   // Kontak operasional / WhatsApp peserta
  jenis_kelamin        String    // "Laki-laki" / "Perempuan"
  tempat_lahir         String?
  tanggal_lahir        DateTime?
  usia                 Int?      // Usia saat tes dilakukan
  kategori_peserta     String?   // "ANAK", "REMAJA", "DEWASA"
  
  // Identitas Orang Tua / Wali (Untuk Anak & Remaja)
  nama_orang_tua       String?
  no_telepon_orang_tua String?
  
  // Latar Belakang (Untuk Remaja & Dewasa)
  pendidikan           String?   // Misal: TK, SD, SMP, SMA, S1
  pekerjaan            String?   // Diisi jika dewasa
  status_pernikahan    String?   // Diisi jika dewasa ("Belum Menikah", "Menikah", dll)
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relasi ke BookingPsikotes
  booking              BookingPsikotes @relation(fields: [id_booking], references: [id], onDelete: Cascade)

  @@map("peserta_psikotes")
}

// ==========================================
// 6. BLOG & KEMITRAAN B2B
// ==========================================

model ArtikelBlog {
  id             String   @id @default(uuid())
  judul          String
  isi            String   @db.Text
  banner_url     String?
  tanggal_terbit DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("artikel_blogs")
}

model PengajuanKerjaSama {
  id             String                   @id @default(uuid())
  nama_instansi  String
  nama_pic       String
  email          String
  no_telepon     String
  kategori       String
  tipe_formulir  String
  pesan          String?                  @db.Text
  jawaban_detail Json?
  status         StatusPengajuanKerjaSama @default(MENUNGGU)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@map("pengajuan_kerja_sama")
}

model FormulirKerjaSama {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  kategori_default  String
  deskripsi         String?  @db.Text
  pertanyaan_khusus Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("formulir_kerja_sama")
}

model ProgramKerjaSama {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  short_name          String
  deskripsi           String   @db.Text
  pelatihan_title     String?
  pelatihan_deskripsi String?  @db.Text
  pelatihan_image     String?
  mitra_title         String?
  mitra_deskripsi     String?  @db.Text
  mitra_image         String?
  warna_tema          String?
  status              String   @default("AKTIF")
  urutan              Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("program_kerja_sama")
}

// ==========================================
// 7. INVOICE
// ==========================================

enum StatusPengirimanInvoice {
  BELUM_DIKIRIM
  DIKIRIM
  GAGAL
}

model Invoice {
  id           String                  @id @default(uuid())
  nomor        String                  @unique // Format: INV-YYYYMMDD-XXXX
  id_transaksi String                  @unique // 1 transaksi = 1 invoice
  // Snapshot data saat invoice diterbitkan (agar tidak berubah jika data master diedit)
  nama_client      String
  no_wa_client     String?             // Nomor WhatsApp klien, bisa null jika tidak ada
  nama_psikolog    String
  judul_layanan    String              // Judul / metode konseling
  tanggal_sesi     DateTime            // Tanggal + jam sesi (WIB disimpan sebagai UTC)
  jenis_sesi       String              // "ONLINE" | "OFFLINE"
  harga            Decimal             @db.Decimal(12, 2)
  metode_bayar     String              // Metode pembayaran: TRANSFER_BANK, E_WALLET, QRIS
  tanggal_bayar    DateTime?           // Tanggal pembayaran transaksi
  tanggal_terbit   DateTime            @default(now())
  // Status pengiriman WA
  status_kirim     StatusPengirimanInvoice @default(BELUM_DIKIRIM)
  sent_at          DateTime?           // Waktu kirim terakhir
  sent_by_admin    String?             // Nama admin yang mengirim
  gagal_alasan     String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  transaksi Transaksi @relation(fields: [id_transaksi], references: [id], onDelete: Restrict)

  @@map("invoices")
}
