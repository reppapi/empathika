{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run tests/integration",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:psikotes": "tsx prisma/seeds-psikotes/seed-psikotes.ts",
    "seed:psikotes": "tsx prisma/seeds-psikotes/seed-psikotes.ts",
    "seed:gad7": "tsx prisma/seeds-psikotes/seeds/seed-gad7.ts",
    "seed:phq9": "tsx prisma/seeds-psikotes/seeds/seed-phq9.ts",
    "prisma:seed:event": "tsx prisma/seed-event.ts",
    "generate:docs": "tsx src/server.ts --export-docs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^5.15.0",
    "bcrypt": "^5.1.0",
    "fastify": "^4.28.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^2.0.0",
    "google-auth-library": "^11.3.1",
    "nodemailer": "^6.9.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prisma": "^5.15.0",
    "supertest": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
